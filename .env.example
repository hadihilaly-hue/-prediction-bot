# Copy to .env. All values optional; public market data + paper trading work with none set.

# paper (default) or live. "live" only sends orders when a command also opts in.
PBOT_MODE=paper

# Kalshi demo (default). Production would be https://api.elections.kalshi.com/trade-api/v2
PBOT_KALSHI_API_BASE=https://external-api.demo.kalshi.co/trade-api/v2
# From https://demo.kalshi.co -> Account & security -> API Keys (RSA or Ed25519 PEM)
PBOT_KALSHI_API_KEY_ID=
PBOT_KALSHI_PRIVATE_KEY_PATH=

# https://the-odds-api.com (free tier: 500 requests/month) — needed for sportsbook_arb
PBOT_ODDS_API_KEY=
PBOT_ODDS_BOOKMAKERS=["pinnacle","draftkings","fanduel"]

# Paper trading
PBOT_PAPER_DB_PATH=data/paper.sqlite
PBOT_PAPER_STARTING_CASH=1000

# Risk limits
PBOT_MAX_ORDER_NOTIONAL=25
PBOT_MAX_POSITION_CONTRACTS=100
PBOT_MIN_EDGE=0.03
